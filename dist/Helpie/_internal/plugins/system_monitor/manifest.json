{
  "name": "system_monitor",
  "display_name": "System Monitor",
  "version": "1.0.0",
  "description": "Real-time CPU, memory, disk, network, and GPU monitoring with alerts",
  "author": "Helpie Team",
  "entry": "plugin.py",
  "api_version": "1.0",
  "permissions": ["system.exec", "settings.read", "settings.write", "voice.speak", "ui.render", "net.request", "commands.register"],
  "hooks": {
    "on_interval": "on_interval"
  },
  "commands": [
    {
      "name": "system_stats",
      "description": "Show current system statistics",
      "handler": "show_stats",
      "patterns": ["system stats", "system status", "cpu usage", "memory usage", "disk usage", "system monitor", "sistem durumu"]
    },
    {
      "name": "system_top_processes",
      "description": "Show top processes by CPU/memory",
      "handler": "show_top_processes",
      "patterns": ["top processes", "running processes", "what is using cpu", "hanging processes"]
    },
    {
      "name": "system_alert",
      "description": "Set threshold alerts for CPU/memory/disk",
      "handler": "set_alert",
      "patterns": ["alert when cpu", "alert when memory", "alert when disk", "notify me when"]
    }
  ],
  "settings_schema": {
    "refresh_interval": {
      "type": "number",
      "default": 30,
      "description": "Auto-refresh interval in seconds (0 to disable)"
    },
    "cpu_alert_threshold": {
      "type": "number",
      "default": 90,
      "description": "CPU usage % to trigger alert"
    },
    "memory_alert_threshold": {
      "type": "number",
      "default": 85,
      "description": "Memory usage % to trigger alert"
    },
    "disk_alert_threshold": {
      "type": "number",
      "default": 90,
      "description": "Disk usage % to trigger alert"
    },
    "enable_gpu": {
      "type": "boolean",
      "default": false,
      "description": "Enable GPU monitoring (requires nvidia-smi)"
    }
  }
}
{
  "name": "spotify",
  "display_name": "Spotify",
  "version": "1.0.0",
  "description": "Control Spotify playback, search, and playlists",
  "author": "Helpie Team",
  "entry": "plugin.py",
  "api_version": "1.0",
  "permissions": ["net.request", "settings.read", "settings.write", "voice.speak", "commands.register"],
  "commands": [
    {
      "name": "play",
      "description": "Play or resume playback",
      "handler": "play",
      "patterns": ["play", "resume", "start music", "spotify play", "müzik çal", "çal"]
    },
    {
      "name": "pause",
      "description": "Pause playback",
      "handler": "pause",
      "patterns": ["pause", "stop music", "duraklat", "müziği durdur"]
    },
    {
      "name": "next_track",
      "description": "Skip to next track",
      "handler": "next_track",
      "patterns": ["next", "next track", "skip", "sonraki", "sonraki şarkı"]
    },
    {
      "name": "previous_track",
      "description": "Go to previous track",
      "handler": "previous_track",
      "patterns": ["previous", "prev", "previous track", "önceki", "önceki şarkı"]
    },
    {
      "name": "search_play",
      "description": "Search and play a track/artist/album",
      "handler": "search_play",
      "patterns": ["play ", "search ", "spotify search ", "çal ", "ara "]
    },
    {
      "name": "volume",
      "description": "Set Spotify volume",
      "handler": "set_volume",
      "patterns": ["volume ", "spotify volume ", "ses "]
    },
    {
      "name": "current_track",
      "description": "Show currently playing track",
      "handler": "current_track",
      "patterns": ["what's playing", "current track", "now playing", "ne çalıyor", "şu an ne çalıyor"]
    },
    {
      "name": "playlists",
      "description": "List user playlists",
      "handler": "list_playlists",
      "patterns": ["playlists", "my playlists", "playlistler", "listelerim"]
    },
    {
      "name": "play_playlist",
      "description": "Play a specific playlist",
      "handler": "play_playlist",
      "patterns": ["play playlist ", "aç playlist ", "çal playlist "]
    }
  ],
  "settings_schema": {
    "client_id": {
      "type": "string",
      "default": "",
      "description": "Spotify Client ID (from developer.spotify.com)"
    },
    "client_secret": {
      "type": "string",
      "default": "",
      "description": "Spotify Client Secret"
    },
    "refresh_token": {
      "type": "string",
      "default": "",
      "description": "OAuth2 Refresh Token"
    },
    "device_id": {
      "type": "string",
      "default": "",
      "description": "Specific device ID to control (optional)"
    }
  }
}
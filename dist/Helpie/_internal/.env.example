# Helpie environment variables
# Copy this file to .env and fill in your values.
# These are optional — the app works without them, but features that need
# them will be disabled until configured.

# Gemini API key (free from https://aistudio.google.com/app/apikey)
# Can also be set in Settings → AI Providers → Gemini
GEMINI_API_KEY=

# GitHub repo for self-updates (default: Flynntaggart26/helpie)
# Set this if you are running a fork
HELPIE_REPO=Flynntaggart26/helpie

# Ollama URL (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Custom OpenAI-compatible endpoint (optional)
OPENAI_URL=
OPENAI_KEY=
OPENAI_MODEL=
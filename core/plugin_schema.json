{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Helpie Plugin Manifest",
  "type": "object",
  "required": ["name", "version", "entry"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "display_name": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "entry": { "type": "string" },
    "api_version": { "type": "string", "default": "1.0" },
    "permissions": {
      "type": "array",
      "items": { "enum": ["fs.read", "fs.write", "net.request", "system.exec", "ui.render", "voice.speak", "screen.capture", "settings.read", "settings.write", "commands.register"] }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "handler"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "handler": { "type": "string" },
          "patterns": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "settings_schema": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["string", "number", "boolean", "select"] },
          "default": {},
          "description": { "type": "string" },
          "options": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
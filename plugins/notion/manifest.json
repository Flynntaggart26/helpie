{
  "name": "notion",
  "display_name": "Notion",
  "version": "1.0.0",
  "description": "Create pages, search, append to databases in Notion",
  "author": "Helpie Team",
  "entry": "plugin.py",
  "api_version": "1.0",
  "permissions": ["net.request", "settings.read", "settings.write", "voice.speak", "commands.register"],
  "commands": [
    {
      "name": "create_page",
      "description": "Create a new page in a database or as a child page",
      "handler": "create_page",
      "patterns": ["create page ", "notion create ", "notion sayfa ", "sayfa oluştur "]
    },
    {
      "name": "search",
      "description": "Search Notion pages and databases",
      "handler": "search",
      "patterns": ["notion search ", "notion ara ", "notion'da ara "]
    },
    {
      "name": "append_page",
      "description": "Append content to an existing page",
      "handler": "append_page",
      "patterns": ["append to page ", "notion append ", "sayfaya ekle "]
    },
    {
      "name": "read_page",
      "description": "Read content of a page",
      "handler": "read_page",
      "patterns": ["read page ", "notion read ", "sayfa oku "]
    },
    {
      "name": "create_database_entry",
      "description": "Add a new entry to a database",
      "handler": "create_database_entry",
      "patterns": ["add to database ", "notion add ", "veritabanına ekle "]
    }
  ],
  "settings_schema": {
    "api_key": {
      "type": "string",
      "default": "",
      "description": "Notion Integration Token (from notion.so/my-integrations)"
    },
    "default_parent_id": {
      "type": "string",
      "default": "",
      "description": "Default parent page/database ID"
    }
  }
}
{
  "name": "example_weather",
  "display_name": "Weather Extended",
  "version": "1.0.0",
  "description": "Extended weather features with forecasts and alerts",
  "author": "Helpie Team",
  "entry": "plugin.py",
  "api_version": "1.0",
  "permissions": ["net.request", "settings.read", "settings.write", "voice.speak", "commands.register"],
  "hooks": {
    "on_wake": "on_wake",
    "on_command": "on_command"
  },
  "commands": [
    {
      "name": "weather_forecast",
      "description": "Get 3-day weather forecast",
      "handler": "weather_forecast",
      "patterns": ["forecast", "weather forecast", "3 day forecast", "hava tahmini"]
    },
    {
      "name": "weather_alerts",
      "description": "Check weather alerts for your area",
      "handler": "weather_alerts",
      "patterns": ["weather alert", "weather warning", "hava uyarı"]
    }
  ],
  "settings_schema": {
    "api_key": {
      "type": "string",
      "default": "",
      "description": "OpenWeatherMap API key (free at openweathermap.org)"
    },
    "units": {
      "type": "select",
      "default": "metric",
      "options": ["metric", "imperial"],
      "description": "Temperature units"
    }
  }
}
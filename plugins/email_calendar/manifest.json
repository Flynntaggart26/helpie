{
  "name": "email_calendar",
  "display_name": "Email & Calendar",
  "version": "1.0.0",
  "description": "Gmail/Outlook email and Calendar integration via Microsoft Graph",
  "author": "Helpie Team",
  "entry": "plugin.py",
  "api_version": "1.0",
  "permissions": ["net.request", "settings.read", "settings.write", "voice.speak", "commands.register", "fs.read", "fs.write"],
  "commands": [
    {
      "name": "read_email",
      "description": "Read recent emails",
      "handler": "read_email",
      "patterns": ["read email", "check email", "show emails", "what emails", "email oku", "emailları oku"]
    },
    {
      "name": "send_email",
      "description": "Send an email",
      "handler": "send_email",
      "patterns": ["send email", "send mail", "email to", "mail gönder", "eposta gönder"]
    },
    {
      "name": "calendar_events",
      "description": "Show upcoming calendar events",
      "handler": "calendar_events",
      "patterns": ["calendar", "upcoming events", "my schedule", "what meetings", "ajanda", "toplantılarım"]
    },
    {
      "name": "create_event",
      "description": "Create a calendar event",
      "handler": "create_event",
      "patterns": ["create event", "schedule meeting", "add to calendar", "toplantı ekle", "ajanda ekle"]
    }
  ],
  "settings_schema": {
    "provider": {
      "type": "select",
      "default": "microsoft",
      "options": ["microsoft", "gmail"],
      "description": "Email provider (Microsoft Graph or Gmail API)"
    },
    "client_id": {
      "type": "string",
      "default": "",
      "description": "OAuth2 Client ID"
    },
    "client_secret": {
      "type": "string",
      "default": "",
      "description": "OAuth2 Client Secret"
    },
    "refresh_token": {
      "type": "string",
      "default": "",
      "description": "OAuth2 Refresh Token"
    },
    "default_folder": {
      "type": "select",
      "default": "inbox",
      "options": ["inbox", "sent", "drafts", "archive"],
      "description": "Default folder to read from"
    },
    "max_emails": {
      "type": "number",
      "default": 5,
      "description": "Max emails to fetch at once"
    }
  }
}
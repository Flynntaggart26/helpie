{
  "name": "clipboard_history",
  "display_name": "Clipboard History",
  "version": "1.0.0",
  "description": "Persistent clipboard history with search, pin, and recall",
  "author": "Helpie Team",
  "entry": "plugin.py",
  "api_version": "1.0",
  "permissions": ["fs.read", "fs.write", "settings.read", "settings.write", "voice.speak", "ui.render", "commands.register"],
  "hooks": {
    "on_clipboard_change": "on_clipboard_change"
  },
  "commands": [
    {
      "name": "clipboard_history",
      "description": "Show recent clipboard history",
      "handler": "show_history",
      "patterns": ["clipboard history", "show clipboard history", "recent clipboard", "panolar geçmişi"]
    },
    {
      "name": "clipboard_pin",
      "description": "Pin a clipboard item",
      "handler": "pin_item",
      "patterns": ["pin clipboard", "pin this clipboard"]
    },
    {
      "name": "clipboard_recall",
      "description": "Recall a pinned clipboard item",
      "handler": "recall_item",
      "patterns": ["recall clipboard", "get pinned clipboard"]
    },
    {
      "name": "clipboard_clear",
      "description": "Clear clipboard history",
      "handler": "clear_history",
      "patterns": ["clear clipboard history", "temizle panolar"]
    }
  ],
  "settings_schema": {
    "max_items": {
      "type": "number",
      "default": 50,
      "description": "Maximum items to keep in history"
    },
    "auto_save": {
      "type": "boolean",
      "default": true,
      "description": "Automatically save clipboard changes"
    }
  }
}
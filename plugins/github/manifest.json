{
  "name": "github",
  "display_name": "GitHub",
  "version": "1.0.0",
  "description": "GitHub issues, PRs, repos, search via REST API",
  "author": "Helpie Team",
  "entry": "plugin.py",
  "api_version": "1.0",
  "permissions": ["net.request", "settings.read", "settings.write", "voice.speak", "commands.register"],
  "commands": [
    {
      "name": "list_issues",
      "description": "List issues in a repository",
      "handler": "list_issues",
      "patterns": ["github issues", "gh issues", "issues list", "github sorunları"]
    },
    {
      "name": "create_issue",
      "description": "Create a new issue",
      "handler": "create_issue",
      "patterns": ["create issue", "github issue", "issue oluştur", "sorun bildir"]
    },
    {
      "name": "list_prs",
      "description": "List pull requests",
      "handler": "list_prs",
      "patterns": ["github prs", "gh prs", "pull requests", "pr listesi"]
    },
    {
      "name": "create_pr",
      "description": "Create a pull request",
      "handler": "create_pr",
      "patterns": ["create pr", "github pr", "pr oluştur", "pull request oluştur"]
    },
    {
      "name": "search_repos",
      "description": "Search repositories",
      "handler": "search_repos",
      "patterns": ["github search", "gh search", "repo ara", "github ara"]
    },
    {
      "name": "get_repo",
      "description": "Get repository info",
      "handler": "get_repo",
      "patterns": ["github repo", "gh repo", "repo info", "depo bilgi"]
    },
    {
      "name": "list_repos",
      "description": "List user/org repositories",
      "handler": "list_repos",
      "patterns": ["github repos", "gh repos", "my repos", "depolarım"]
    }
  ],
  "settings_schema": {
    "token": {
      "type": "string",
      "default": "",
      "description": "GitHub Personal Access Token (classic or fine-grained)"
    },
    "default_owner": {
      "type": "string",
      "default": "",
      "description": "Default repository owner (user or org)"
    },
    "default_repo": {
      "type": "string",
      "default": "",
      "description": "Default repository name"
    }
  }
}
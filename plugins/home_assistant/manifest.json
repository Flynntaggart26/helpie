{
  "name": "home_assistant",
  "display_name": "Home Assistant",
  "version": "1.0.0",
  "description": "Control Home Assistant entities (lights, switches, climate, sensors)",
  "author": "Helpie Team",
  "entry": "plugin.py",
  "api_version": "1.0",
  "permissions": ["net.request", "settings.read", "settings.write", "voice.speak", "commands.register"],
  "commands": [
    {
      "name": "turn_on",
      "description": "Turn on a light/switch/entity",
      "handler": "turn_on",
      "patterns": ["turn on ", "open ", "aç ", "hass turn on "]
    },
    {
      "name": "turn_off",
      "description": "Turn off a light/switch/entity",
      "handler": "turn_off",
      "patterns": ["turn off ", "close ", "kapat ", "hass turn off "]
    },
    {
      "name": "toggle",
      "description": "Toggle a light/switch/entity",
      "handler": "toggle",
      "patterns": ["toggle ", "hass toggle "]
    },
    {
      "name": "set_light",
      "description": "Set light brightness/color",
      "handler": "set_light",
      "patterns": ["set light ", "light brightness ", "ışık ", "ışığı "]
    },
    {
      "name": "set_climate",
      "description": "Set climate temperature/mode",
      "handler": "set_climate",
      "patterns": ["set climate ", "set temperature ", "klima ", "sıcaklık "]
    },
    {
      "name": "get_state",
      "description": "Get state of an entity",
      "handler": "get_state",
      "patterns": ["state of ", "status of ", "hass state ", "durum "]
    },
    {
      "name": "list_entities",
      "description": "List entities by domain",
      "handler": "list_entities",
      "patterns": ["list lights", "list switches", "list entities", "hass list "]
    },
    {
      "name": "call_service",
      "description": "Call any Home Assistant service",
      "handler": "call_service",
      "patterns": ["hass call ", "hass service "]
    }
  ],
  "settings_schema": {
    "url": {
      "type": "string",
      "default": "http://homeassistant.local:8123",
      "description": "Home Assistant URL (e.g., http://homeassistant.local:8123 or https://your-domain.duckdns.org)"
    },
    "token": {
      "type": "string",
      "default": "",
      "description": "Long-Lived Access Token (from HA Profile > Long-Lived Access Tokens)"
    },
    "verify_ssl": {
      "type": "boolean",
      "default": true,
      "description": "Verify SSL certificate (disable for self-signed certs)"
    }
  }
}